{
  "name": "sqrzl-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && npm run generate",
    "generate": "askr ssg --config ./ssg.config.ts --output ./dist/static",
    "analyze": "askr analyze --check",
    "preview": "vp preview --outDir dist/static",
    "type-check": "tsc --noEmit",
    "lint": "vp lint .",
    "fmt": "vp fmt ."
  },
  "dependencies": {
    "@askrjs/askr": "^0.5.0",
    "@askrjs/logos": "^0.5.0",
    "@askrjs/lucide": "^0.5.0",
    "@askrjs/themes": "^0.5.0",
    "@askrjs/ui": "^0.5.0"
  },
  "devDependencies": {
    "@askrjs/cli": "^0.5.0",
    "@askrjs/vite": ">=0.5.0 <0.6.0",
    "@types/node": "^26.6.5",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
