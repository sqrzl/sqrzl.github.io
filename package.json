{
  "name": "sqrzl-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && npm run generate && node scripts/generate-content.mjs",
    "generate": "askr ssg --config ./ssg.config.ts --output ./dist/static",
    "analyze": "askr analyze --check",
    "preview": "vp preview --outDir dist/static",
    "type-check": "tsc --noEmit",
    "lint": "vp lint .",
    "fmt": "vp fmt .",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@askrjs/askr": "^0.5.1",
    "@askrjs/logos": "^0.5.0",
    "@askrjs/lucide": "^0.5.1",
    "@askrjs/themes": "^0.5.1",
    "@askrjs/ui": "^0.5.0"
  },
  "devDependencies": {
    "@askrjs/cli": "^0.5.1",
    "@askrjs/vite": ">=0.5.0 <0.6.0",
    "@types/node": "^26.6.6",
    "parse5": "^8.1.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.6.0"
  },
  "overrides": {
    "@npmcli/map-workspaces": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.8"
    }
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
